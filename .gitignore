# Rust build output; Cargo.lock will be committed for the executable.
/target/
/dist/

# Mara local mutation coordination; schema and authored knowledge are tracked.
/.mara/mutation.lock
/.mara/transaction/

# Work housekeeping: local lock and publication artifacts, never live records/progress.
/.work/operations.lock
/.work/**/.operation-*
/.work/**/.storage-*
/.work/**/.stage-*

# Local secrets and editor/OS scratch files.
.env
.env.*
!.env.example
*.swp
*.swo
.DS_Store
